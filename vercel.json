{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(anim|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "konpo-symbol-index.vercel.app"
        }
      ],
      "destination": "https://symbols.konpo.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "konpo-symbol-index.vercel.app"
        }
      ],
      "destination": "https://symbols.konpo.co/:path*",
      "permanent": true
    }
  ]
}
